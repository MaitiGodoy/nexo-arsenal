{
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "deepseek-v4-flash",
    "baseUrl": "https://api.deepseek.com"
  },
  "$version": 4,
  "permissions": {
    "allow": [
      "Bash(redis-cli *)",
      "Monitor(do *)",
      "Monitor(sleep *)",
      "Monitor(done)",
      "Bash(git *)",
      "Bash(printf *)",
      "Bash(do *)",
      "Bash(done)",
      "Bash(echo *)",
      "Bash(head *)"
    ]
  },
  "ui": {
    "autoModeAcknowledged": true,
    "feedbackLastShownTimestamp": 1785916466014
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.local/bin/rtk hook claude"
          },
          {
            "type": "command",
            "command": "/usr/bin/bash /root/.qwen/hooks/block-destructive-bash-global.sh"
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/pre-commit-seguranca.js\""
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/bloquear-comando-destrutivo.js\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/bloquear-segredo-escrita.js\""
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/bloquear-escrita-sem-catalogo.js\""
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/bloquear-fase-sem-plano.js\""
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/avisar-economia-task.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/bash /root/.qwen/hooks/check-settings.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/sessao-inicia.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/bash /root/.qwen/hooks/nexo-paidocriss-reminder.sh"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/bash /root/.qwen/hooks/nexoflow-suggest.sh"
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/prompt-submit-protocolo.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/marcar-escrita.js\""
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/sugerir-evolucao-nucleo.js\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/marcar-catalogo-lido.js\""
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/marcar-revisao-feita.js\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/precompact-preservar.js\""
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/bloquear-fim-sem-memoria.js\""
          },
          {
            "type": "command",
            "command": "node \"/root/.qwen/setup-nexo/hooks/bloquear-fim-sem-revisao.js\""
          }
        ],
        "matcher": ""
      }
    ]
  },
